# Backend API URL
VITE_API_URL=http://localhost:8000

# Organization slug — required for multi-tenant setup
# Get from: cd backend && python scripts/seed_dev.py
VITE_ORG_SLUG=dev-org-xxxxxxxx

# Paddle payment integration
# Get token from: https://vendors.paddle.com/settings/api
# For development, use sandbox token; for production, use live token
VITE_PADDLE_CLIENT_TOKEN=test_...
