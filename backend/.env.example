DATABASE_URL=postgresql://postgres:password@localhost:5432/lexara

# OpenAI — required for LLM answer generation
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
JWT_SECRET_KEY=change-me-min-32-chars
CHAT_TEMPERATURE=0.2
CHAT_TOP_P=0.9
CHAT_MAX_TOKENS=600
CHAT_FREQUENCY_PENALTY=0.1
FAISS_DATA_DIR=./data/faiss
UPLOADS_DATA_DIR=./data/uploads
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
DEBUG=false
ENVIRONMENT=production
