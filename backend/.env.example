# Database connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/lexara

# OpenAI API — required for LLM answer generation
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# JWT authentication secret — MUST be changed in production!
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-min-32-chars

# LLM Settings
CHAT_TEMPERATURE=0.2
CHAT_TOP_P=0.9
CHAT_MAX_TOKENS=1500
CHAT_FREQUENCY_PENALTY=0.1

# File storage
FAISS_DATA_DIR=./data/faiss
UPLOADS_DATA_DIR=./data/uploads

# Embeddings
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Paddle — Payment processing
# Get keys from: https://vendors.paddle.com/settings/api
PADDLE_API_KEY=pdl_live_...
PADDLE_CLIENT_TOKEN=live_...
PADDLE_PRICE_PRO=pri_...
PADDLE_PRICE_BUSINESS=pri_...

# Cloudflare R2 — Object storage for documents
# Get credentials from: https://dash.cloudflare.com/
R2_ENDPOINT_URL=https://xxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_TOKEN_VALUE=cfat_...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=lexara-documents

# Resend — Email service
# Get key from: https://resend.com/api-keys
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@lexara.app

# Environment
DEBUG=false
ENVIRONMENT=production
